</mj-column>
</mj-section>

<!--SECOND SECTION-->
<mj-section>
<mj-column width="10%" padding="10px 0px 0px 20px">
<mj-text font-size="28px">&#9889</mj-text>
</mj-column>
<mj-column width="80%" padding="15px 10px 10px 15px">
<mj-text mj-class="heading" font-size="16px">Biome</mj-text>
<mj-text>One tool to lint, format and check your JS/TS.
 Replaces ESLint + Prettier and runs 10x faster.</mj-text>
<mj-text color="#ff6b35" font-weight="600" >Open Source<mj-text>
</mj-column>
</mj-section>

<mj-section>
<!--DIVIDER-->
<mj-column width="100%" background-color="#1e2a3a">
<mj-divider  padding="0" border-style="solid" border-color="#1e2a3a" border-width="1px"/>
