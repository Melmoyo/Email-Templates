<mjml>
<mj-head>
<!--GOOGLE FONTS-->
<mj-font name="Space Grotesk" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" />
<!--GLOBAL STYLES-->
  <mj-attributes>

    <!--ALL ELEMENTS-->
    <mj-all font-family="'Space Grotesk', Arial, sans-serif" />

    <!--BODY-->
    <mj-body background-color="#F4F2FF" />

    <!--ALL SECTIONS-->
    <mj-section
      background-color="#ffffff"
      padding="0" />

    <!--ALL COLUMNS-->
    <mj-column padding="0" />

    <!--TEXT-->
    <mj-text
      font-size="15px"
      font-weight="400"
      color="#6B6480"
      line-height="1.7"
      padding="0" />

    <!--BUTTON-->
    <mj-button
      background-color="#4A2C8F"
      color="#ffffff"
      font-size="15px"
      font-weight="700"
      border-radius="8px"
      inner-padding="16px 48px"
      letter-spacing="0.02em" />

    <!--DIVIDER-->
    <mj-divider
      border-color="#F0EEF8"
      border-width="1px"
      border-style="solid"
      padding="0" />

    <!--IMAGE-->
    <mj-image padding="0" />

  </mj-attributes>

  <!--CUSTOM CSS-->
  <mj-style>
    a {
      color: #4A2C8F;
      text-decoration: none;
    }
    .security-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #F4F2FF;
      border: 1px solid #E4DEFF;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      color: #4A2C8F;
      letter-spacing: 0.05em;
    }
    .fallback-url {
      display: block;
      background: #F4F2FF;
      border: 1px solid #E4DEFF;
      border-radius: 6px;
      padding: 10px 16px;
      font-size: 12px;
      color: #4A2C8F;
      font-weight: 500;
      word-break: break-all;
      text-decoration: none;
    }
    .info-card {
      background: #ffffff;
      border: 1px solid #F0EEF8;
      border-radius: 12px;
    }
    .warning-card {
      background: #FFF8F6;
      border: 1px solid #FFE4DC;
      border-left: 3px solid #FF6B35;
      border-radius: 0 8px 8px 0;
    }
  </mj-style>


</mj-head>
<mj-body>
<!--ACCENT STRIP-->
<mj-section>
<mj-column>
<mj-divider border-color="#4A2C8F" border-width="3px" padding="0px"/>
</mj-column>
</mj-section>

<!--HEADER-->
<mj-section padding="28px 40px">
<mj-column width="60%" >
<mj-text font-size="32px" color="#4A2C8F">Vaultly.</mj-text>
</mj-column>
<mj-column width="40%" padding-top="16px" >
<mj-text css-class="security-badge">. Security Alert</mj-text>
</mj-column>
</mj-section>


<mj-section padding="28px 40px">
<mj-column>
<mj-image></mj-image>
<mj-text align="center">Reset your password</mj-text>
<mj-text align="center">We received a request to reset the password for your Vaultly account. 
Click the button below to set a new one.</mj-text>
<mj-button>Reset My Password</mj-button>
<mj-text align="center">This link expires in 24 hours</mj-text>
</mj-column>
</mj-section>

<!--INFORMATION -->

<mj-section  padding="10px 20px 10px 20px" css-class="info-card">
<mj-column width="10%" padding="20px" >
<mj-text font-size="28px">&#128587;</mj-text>

</mj-column>
<mj-column width="90%" padding="10px">
<mj-text font-weight="600" >Didn't request this?</mj-text>

<mj-text>Use a strong unique password. We recommend at least 12 characters with a mix of letters, numbers and symbols.</mj-text>
</mj-column>

</mj-section>

<mj-section  padding="10px 20px 10px 20px" css-class="info-card">

<mj-column width="10%" padding="20px" >
<mj-text font-size="28px">&#128336;</mj-text>
</mj-column>
<mj-column width="90%" padding="10px">
<mj-text font-weight="600" >Link expires in 24 hours</mj-text>
<mj-text>For your security this link will stop working after 24 hours. Request a new one if it expires.</mj-text>
</mj-column>

</mj-section>

<mj-section  padding="10px 20px 10px 20px" css-class="info-card">
<mj-column width="10%" padding="20px 0 20px 0" >
<mj-text font-size="28px">&#128737;</mj-text>
</mj-column>

<mj-column width="85%" padding="10px">
<mj-text font-weight="600"  >Keep your account secure</mj-text>
<mj-text>Use a strong unique password. We recommend at least 12 characters with a mix of letters, numbers and symbols.</mj-text>
</mj-column>


</mj-section>


<mj-section padding="28px 40px" >

<mj-column width="1%" >
<mj-divider border-color="#FF6B35" border-width="80px" />
</mj-column>
<mj-column width="90%" border="1px solid #FFE4DC">
<mj-text padding="0 0 0 10px">&#9888;<span style="padding-left:5px;">Never share this link.</span>
 Vaultly will never ask you to forward this email or share your reset link with anyone — including our support team.</mj-text>
</mj-column>
</mj-section>

<mj-section>
<mj-column>
<mj-text align="center">Button not working? Copy this link into your browser</mj-text>
</mj-column>

</mj-section>
<mj-section padding="28px 40px" >
<mj-column border="1px solid #4A2C8F" border-radius="6px">
<mj-text align="center" container-background-color="#f4f2fe"><a href="#"  >https://vaultly.app/reset?token=a3f9b2c1d4e5...</a></mj-text>
</mj-column>
</mj-section>

<mj-section padding="28px 40px" >

<mj-column>
<mj-text align="center">This email was sent to you because a password reset was requested for your Vaultly account. If you have concerns about your account security contact our support team immediately.</mj-text>
</mj-column>
</mj-section>

<!--FOOTER-->
<mj-section background-color="#1A1025"  padding="28px 40px">
<mj-group>
<mj-column width="20%">
<mj-text font-size="28px"><span>Vault</span><span style="color:#4A2C8F">ly</span></mj-text>
</mj-column>
<mj-column padding-top="10px">
<mj-text align="right">Security</mj-text>
</mj-column>
<mj-column padding-top="10px">
<mj-text align="right">Privacy</mj-text>
</mj-column>
<mj-column padding-top="10px">
<mj-text align="right">Help</mj-text>
</mj-column>
</mj-group>
</mj-section>

<!--DIVIDER-->
<mj-section>
<mj-column>
<mj-divider/>
</mj-column>
</mj-section>

<!--COPYRIGHT-->
<mj-section  background-color="#1A1025"  padding="28px 40px">
<mj-column width="50%">
<mj-text>&copy; 2026 Vaultly. All rights reserved.</mj-text>
</mj-column>

<mj-column width="20%">
<mj-text color="#444444">
<a href="#" style="color:#444444;">Unsubscribe</a>
<mj-text>
</mj-column>
</mj-section>


</mj-body>

</mjml>
