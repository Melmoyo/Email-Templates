  &nbsp;&nbsp;&nbsp;
  <span style="color:#FFE500; font-weight:600; font-size:22px;">R999</span></mj-text>
  </mj-column>
<mj-column width="2%"><mj-spacer height="10px"/></mj-column>


    <!-- Product 2 -->
  <mj-column padding="0 0 0 6px"
    background-color="#0D0D0D"
    border="1px solid #1A1A1A" width="49%">


    <!--RIGHT SIDE (TAG)-->
<mj-text font-size="14px" align="right" padding="15px">
<span style="background:#FFE500; color:#000000; padding:4px; font-weight:600">30% OFF</mj-text>
    <!--LEFT SIDE-->
    
  <mj-text font-size="32px" color="#ffffff">&#9000;</mj-text>
    <mj-text color="#444444" text-transform="uppercase">pheripherals</mj-text>
    <mj-text color="#ffffff" font-size="16px" font-weight="600" text-transform="uppercase">Pro Wireless Headphones</mj-text>
  <mj-text><span style="color:#444444;text-decoration:line-through;">R1,799</span>
  &nbsp;&nbsp;&nbsp;
  <span style="color:#FFE500; font-weight:600; font-size:22px;">R1,079</span></mj-text>
    
  </mj-column>

</mj-section>

<!-- Row 2 — next two products -->
<mj-section background-color="#000000"
  padding="0 40px 40px 40px">
<!-- Product 3 -->
  <mj-column padding="0 6px 0 0"
    background-color="#0D0D0D"
    border="1px solid #1A1A1A" width="49%">
    

     <!--RIGHT SIDE (TAG)-->
<mj-text font-size="14px" align="right" padding="15px">
<span style="background:#FFE500; color:#000000; padding:4px; font-weight:600">45% OFF</mj-text>
    <!--LEFT SIDE-->
    <mj-text font-size="32px" color="#ffffff">&#128433;</mj-text>

    <mj-text color="#444444" text-transform="uppercase">pheripherals</mj-text>
    <mj-text color="#ffffff" font-size="16px" font-weight="600" text-transform="uppercase">Pro Wireless Headphones</mj-text>
  <mj-text>
  <span style="color:#444444;text-decoration:line-through;">R899</span>
  &nbsp;&nbsp;&nbsp;
  <span style="color:#FFE500; font-weight:600; font-size:22px;">R584</span>
  </mj-text>
       
  </mj-column>
  <mj-column width="2%"><mj-spacer height="10px"/></mj-column>
  
 <!-- Product 4 -->
  <mj-column padding="0 0 0 6px"
    background-color="#0D0D0D"
    border="1px solid #1A1A1A" width="49%">
   

     <!--RIGHT SIDE (TAG)-->
<mj-text font-size="14px" align="right" padding="15px">
<span 
style="background:#FFE500; color:#000000; padding:4px; font-weight:600">50% OFF</mj-text>
    <!--LEFT SIDE-->
    <mj-text font-size="32px">&#128161;</mj-text>

    <mj-text color="#444444" text-transform="uppercase">lighting</mj-text>
    <mj-text color="#ffffff" font-size="16px" font-weight="600" text-transform="uppercase">Pro Wireless Headphones</mj-text>
  <mj-text><span style="color:#444444;text-decoration:line-through;">R649</span>
  &nbsp;&nbsp;&nbsp;
  <span style="color:#FFE500; font-weight:600; font-size:22px;">R324</span></mj-text>
    
  </mj-column>

</mj-section>

<!--DEAL OF THE DAY-->

<mj-section border="2px solid #FFE500" padding="0">

<!--LEFT-->
<mj-column width="60%"  padding="0" >
<mj-text color="#ffffff" text-transform="uppercase" ><span style="background:#FFE500; padding:4px; color:#000000; font-weight:600;">&#127775;deal of the day</span></mj-text>
<mj-text  color="#ffffff" font-size="28px" font-weight="700" text-transform="uppercase" font-family="Bebas Neue">4K Webcam</mj-text>
<mj-text color="#444444">Crystal clear 4K video, built-in noise cancelling mic, works with every platform.</mj-text>
<mj-text
><span style="color:#FFE500;font-size:22px; font-weight:600;">799</span>  &nbsp;&nbsp;&nbsp;
<span style="text-decoration:line-through; color:#444444">R1599</span></mj-text>
<mj-button background-color="#FFE500" color="#000000" font-weight="600" text-transform="uppercase" align="left">Grab this deal &#8594;</mj-button>
</mj-column>

<!--RIGHT-->

<mj-column width="40%" vertical-align="top" >
<mj-text align="center" font-size="80px" padding="50% 0 50% 0">&#128247;</mj-text>
</mj-column>
</mj-section>

<!--SHOP BY CATEGORY-->
<mj-section padding="0px">
<!--FIRST ROW-->
<mj-column >
<mj-button align="center" background-color="#000000" color="#FFE500" border="1px solid #FFE500" text-transform="uppercase">Audio</mj-button>
</mj-column>
<mj-column >
