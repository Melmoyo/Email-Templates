</mj-column>
</mj-section>

<!--OFFER ENDS MIDNIGHT-->
<mj-section>
<mj-column background-color="#FFE500" vertical-align="middle">
<mj-text color="#000000" font-weight="600" font-size="16px" align="center" text-transform="uppercase">&#9200;  OFFER ENDS MIDNIGHT FRIDAY — DON'T MISS OUT</mj-text>
<mj-text color="#444444" align="center" text-transform="uppercase" font-weight="500">Limited stock on selected items</mj-text>
</mj-column>
</mj-section>

<!--FOOTER-->

<mj-section>
<mj-column width="40%">
<mj-text color="#ffffff" font-weight="600" font-family="Bebas Neue" font-size="22px">STACKD</mj-text>
</mj-column>
<mj-column width="60%">
